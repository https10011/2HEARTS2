{
  "name": "twohearts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TwoHearts V1 — private, offline-first, local-first couples app for Android (React + Capacitor).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "cap:sync": "cap sync",
    "cap:sync:android": "cap sync android",
    "android:open": "cap open android",
    "android:build": "cap sync android && cd android && ./gradlew assembleDebug",
    "test": "node --experimental-transform-types --no-warnings --test \"tests/**/*.test.ts\"",
    "design:assets": "node scripts/generate-design-assets.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^6.0.1",
    "@capacitor-community/sqlite": "^6.0.1",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/device": "^6.0.3",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/status-bar": "^6.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
